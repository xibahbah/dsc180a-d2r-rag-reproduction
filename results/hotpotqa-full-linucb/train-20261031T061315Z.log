 culture in New York, Los Angeles and San Francisco.', 'node_id': 'deeeb95d-17ce-491c-a457-48c666633355', 'score': 1.1978461742401123}], 'consistency_check': 'CONSISTENT', 'entailment_check': {'query': 'NEUTRAL', 'response': 'ENTAILMENT'}, 'latency': 1.1391736287623644, 'vram_usage': 1.18896484375}
