eksandr Pushkin.', 'node_id': '61348308-41dd-4390-bccb-bde35f80f97f', 'score': 1.0147783756256104}], 'consistency_check': 'CONSISTENT', 'entailment_check': {'query': 'NEUTRAL', 'response': 'ENTAILMENT'}, 'latency': 1.078229583799839, 'vram_usage': 1.22412109375}
