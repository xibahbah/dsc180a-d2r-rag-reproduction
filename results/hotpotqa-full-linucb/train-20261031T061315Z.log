ore': 1.1686644554138184}, {'text': 'Austin Young (born April 12, 1966) is an American photographer, film maker and new media artist currently based in Los Angeles. His work has created an encyclopedic documentation of sub and trans culture in New York, Los Angeles and San Francisco.', 'node_id': 'deeeb95d-17ce-491c-a457-48c666633355', 'score': 1.1978461742401123}], 'consistency_check': 'CONSISTENT', 'entailment_check': {'query': 'NEUTRAL', 'response': 'ENTAILMENT'}, 'latency': 0.8303863145411015, 'vram_usage': 1.18896484375}
