'score': 1.1159831285476685}, {'text': 'Donald Lee Evans (born March 14, 1964 in Raleigh, North Carolina) is a former American football defensive end who played eight seasons in the National Football League for the Los Angeles Rams, Philadelphia Eagles, Pittsburgh Steelers, and New York Jets. He attended high school in Raleigh at Athens Drive High School, graduating in 1982.', 'node_id': 'f7a51571-f3b0-401a-a256-bb55508bda89', 'score': 1.1308053731918335}], 'consistency_check': 'CONSISTENT', 'entailment_check': {'query': 'ENTAILMENT', 'response': 'NEUTRAL'}, 'latency': 0.8657804429531097, 'vram_usage': 1.16552734375}
