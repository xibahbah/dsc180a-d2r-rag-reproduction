, 'score': 1.1044692993164062}], 'consistency_check': 'CONSISTENT', 'entailment_check': {'query': 'ENTAILMENT', 'response': 'NEUTRAL'}, 'latency': 0.9951639827340841, 'vram_usage': 1.23583984375}
