tors, country music stars and other actors.', 'node_id': '1c541e45-6ada-410b-91eb-7a2163ef8f49', 'score': 1.166698932647705}], 'consistency_check': 'CONSISTENT', 'entailment_check': {'query': 'CONTRADICTION', 'response': 'NEUTRAL'}, 'latency': 0.7057069465517998, 'vram_usage': 1.23583984375}
