d Capon Lake.', 'node_id': 'ffb5cad2-1cb1-4345-ae57-2b4a6c22b481', 'score': 1.1716423034667969}, {'text': 'It is located in the drainage of Hazel Creek, an area which historically had a small population and was abandoned after the construction of Fontana Lake and the national park. It is the only structure remaining in its immediate vicinity.', 'node_id': 'de3d7bbb-bd13-47a9-9398-1b3f1aa31ea7', 'score': 1.1726728677749634}], 'consistency_check': 'MISSING', 'entailment_check': {'query': 'CONTRADICTION', 'response': 'NEUTRAL'}, 'latency': 0.7215261664241552, 'vram_usage': 1.29443359375}
