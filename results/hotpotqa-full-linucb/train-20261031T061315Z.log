 'node_id': 'deeeb95d-17ce-491c-a457-48c666633355', 'score': 1.2056804895401}], 'consistency_check': 'MISSING', 'entailment_check': {'query': 'CONTRADICTION', 'response': 'CONTRADICTION'}, 'latency': 0.4591525234282017, 'vram_usage': 1.17724609375}
