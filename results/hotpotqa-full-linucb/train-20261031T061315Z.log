o.", 'node_id': '245da082-e65f-452d-b985-0eb3282c4ee4', 'score': 1.0275354385375977}, {'text': 'Catherine was an alternative rock band from Chicago, Illinois that was active from 1985 to 1998. They were signed to TVT Records.', 'node_id': '7b9d112d-1781-4405-9ef0-32d8f3db2e83', 'score': 1.0442336797714233}], 'consistency_check': 'MISSING', 'entailment_check': {'query': 'CONTRADICTION', 'response': 'CONTRADICTION'}, 'latency': 0.693053599447012, 'vram_usage': 1.27099609375}
