Ottoman Sultans:', 'node_id': '59c197ab-977f-4c8a-82be-2f799a5fd0d4', 'score': 1.000591516494751}], 'consistency_check': 'CONSISTENT', 'entailment_check': {'query': 'NEUTRAL', 'response': 'ENTAILMENT'}, 'latency': 0.9067769795656204, 'vram_usage': 1.21240234375}
