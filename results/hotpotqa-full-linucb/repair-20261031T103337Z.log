g province of China.', 'node_id': '9f36de81-e466-4c1d-a0fb-5aa23bebbd08', 'score': 1.0849021673202515}], 'consistency_check': 'MISSING', 'entailment_check': {'query': 'NEUTRAL', 'response': 'ENTAILMENT'}, 'latency': 1.2668084595352411, 'vram_usage': 1.16552734375}
