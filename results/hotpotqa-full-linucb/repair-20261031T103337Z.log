6f993-b1c1-4084-b6da-b3754efc4834', 'score': 1.0668284893035889}], 'consistency_check': 'MISSING', 'entailment_check': {'query': 'NEUTRAL', 'response': 'ENTAILMENT'}, 'latency': 1.017616106197238, 'vram_usage': 1.15380859375}
