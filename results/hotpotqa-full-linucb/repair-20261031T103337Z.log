"romantic" cues.', 'node_id': 'ce996b09-fffb-4f19-b712-7e02153fbe1d', 'score': 0.8633745908737183}, {'text': 'The screenplay was written by John Sayles, the score was composed by James Horner, and the special effects were designed by James Cameron.', 'node_id': '10ca249f-e2a2-41bc-a7d3-29a0b498d502', 'score': 0.9202984571456909}], 'consistency_check': 'CONFLICT', 'entailment_check': {'query': 'ENTAILMENT', 'response': 'ENTAILMENT'}, 'latency': 0.5823900550603867, 'vram_usage': 1.25927734375}
