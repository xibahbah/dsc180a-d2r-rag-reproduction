: 'ed707e44-2d90-4cb6-94bb-b1b2727b48dc', 'score': 1.0434396266937256}], 'consistency_check': 'MISSING', 'entailment_check': {'query': 'ENTAILMENT', 'response': 'NEUTRAL'}, 'latency': 0.7373717371374369, 'vram_usage': 1.23583984375}
