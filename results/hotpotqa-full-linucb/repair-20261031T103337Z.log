Index number of 2571.', 'node_id': '444a5b10-30df-4cdf-97f9-95e7d50fdb3f', 'score': 0.9076842665672302}], 'consistency_check': 'MISSING', 'entailment_check': {'query': 'NEUTRAL', 'response': 'NEUTRAL'}, 'latency': 0.5383298248052597, 'vram_usage': 1.25927734375}
